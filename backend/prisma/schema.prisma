// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RECRUITER
  CANDIDATE
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

model User {
  id          String   @id @default(uuid())
  fullName    String
  email       String   @unique
  password    String
  role        Role
  isSuspended Boolean  @default(false)
  isVerified  Boolean  @default(false)
  verifyToken String?
  resetOtp        String?
  resetOtpExpiry  DateTime?
  createdAt   DateTime @default(now())
  subscriptionTier   String   @default("FREE")
  subscriptionEndsAt DateTime?
  razorpayOrderId    String?

  candidateProfile CandidateProfile?
  recruiterProfile RecruiterProfile?
  companyProfile   CompanyProfile?
  candidatePortfolio CandidatePortfolio?
  mockInterviews   MockInterview[]

  jobs             Job[]
  applications     Application[]
  savedJobs        SavedJob[]
  notifications    Notification[]
  companyDocuments CompanyDocument[]
  subscription     Subscription?
  payments         Payment[]
}

model CandidateProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  skills      String[]
  education   String?
  experience  String?
  resumeUrl   String?
  professionalSummary String?
  strengths String[]
  weaknesses String[]
  hiringRecommendation String?
  linkedinUrl String?
  githubUrl String?
  portfolioUrl String?
  profileImage String?
  certifications String[]
  resumeHistory Json?
  degreeUrl String?
  certUrls  Json?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecruiterProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyName String
  companyLogo String?
  companyWebsite String?
  companyDescription String?
  industry String?
  companySize String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Job {
  id            String   @id @default(uuid())
  title         String
  description   String
  location      String
  salary        String?
  jobType       JobType
  skillsRequired String[]
  status        String @default("OPEN")
  createdAt     DateTime @default(now())

  recruiterId String
  recruiter   User @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  applications Application[]
  savedJobs    SavedJob[]
}

model Application {
  id           String   @id @default(uuid())
  candidateId  String
  jobId        String

  matchScore   Float?
  aiFeedback   String?

  status       String @default("APPLIED")
  pipelineStage String @default("Applied")
  interviewDate DateTime?
  interviewTime String?
  interviewLink String?
  interviewerNotes String?

  createdAt    DateTime @default(now())

  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterNotes String?
  offerLetterUrl String?
  offerLetterDetails Json?

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
}

model SavedJob {
  id           String   @id @default(uuid())
  candidateId  String
  jobId        String
  createdAt    DateTime @default(now())

  candidate User @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([candidateId, jobId])
  @@index([candidateId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model CompanyDocument {
  id          String   @id @default(uuid())
  title       String
  content     String
  category    String   @default("GENERAL") // "JD", "POLICY", "GUIDELINE", "GENERAL"
  createdAt   DateTime @default(now())
  recruiterId String
  recruiter   User     @relation(fields: [recruiterId], references: [id], onDelete: Cascade)

  @@index([recruiterId])
}

model MockInterview {
  id                  String   @id @default(cuid())
  candidateId         String
  jobRole             String
  questions           Json
  answers             Json
  communicationScore  Int
  technicalScore      Int
  confidenceScore     Int
  overallRating       String
  recommendation      String
  createdAt           DateTime @default(now())
  candidate           User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model CompanyProfile {
  id          String  @id @default(cuid())
  recruiterId String  @unique
  companyName String
  logo        String?
  website     String?
  industry    String?
  teamSize    String?
  about       String?
  location    String?
  founded     String?
  recruiter   User    @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
}

model CandidatePortfolio {
  id             String   @id @default(cuid())
  candidateId    String   @unique
  githubUrl      String?
  linkedinUrl    String?
  portfolioUrl   String?
  projects       Json?
  certifications Json?
  achievements   Json?
  candidate      User     @relation(fields: [candidateId], references: [id], onDelete: Cascade)
}

model ExternalJob {
  id                 String   @id @default(uuid())
  title              String
  company            String
  location           String
  description        String
  skills             String[]
  salary             String?
  applyUrl           String
  source             String
  sourceType         String   // "RSS", "WEB", "TELEGRAM"
  postedDate         DateTime @default(now())
  fetchedAt          DateTime @default(now())
  isActive           Boolean  @default(true)

  // Gemini AI enhanced fields
  summary            String?
  requiredSkills     String[]
  experienceLevel    String?
  category           String?

  @@index([company])
  @@index([location])
  @@index([postedDate])
}

model ActivityLog {
  id         String   @id @default(uuid())
  action     String   // "LOGIN", "REGISTER", "JOB_CREATED", "JOB_UPDATED", "JOB_DELETED", "APPLICATION_SUBMITTED", "INTERVIEW_SCHEDULED", "OFFER_LETTER_GENERATED", "PAYMENT_SUBMITTED", "PAYMENT_APPROVED", "USER_SUSPENDED", "USER_DELETED"
  details    String
  userId     String
  entity     String?
  entityId   String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model Subscription {
  id         String   @id @default(uuid())
  userId     String   @unique
  planName   String
  startDate  DateTime @default(now())
  expiryDate DateTime
  status     String   // "ACTIVE", "EXPIRED", "CANCELLED"

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String   @id @default(uuid())
  userId        String
  transactionId String   @unique
  paymentMethod String
  amount        Float
  status        String   // "SUCCESS", "FAILED", "PENDING", "REJECTED"
  createdAt     DateTime @default(now())

  // Manual UPI fields (nullable for legacy fake/razorpay rows)
  planName      String?
  billingCycle  String?
  orderId       String?
  payerUpi      String?
  adminNote     String?
  reviewedAt    DateTime?
  reviewedBy    String?

  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}