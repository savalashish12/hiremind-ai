# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connection_limit=1

# Auth
JWT_SECRET=your_jwt_secret_min_32_chars

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Groq (fallback AI)
GROQ_API_KEY=your_groq_api_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (Gmail SMTP)
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password

# Manual UPI checkout (owner payee shown in payment modal)
MANUAL_PAYEE_NAME=Owner Name
MANUAL_MERCHANT_LABEL=HireMind AI
MANUAL_UPI_PRIMARY=owner@upi
MANUAL_UPI_SECONDARY=owner@upi
MANUAL_QR_IMAGE_URL=/upi-qr.jpg
MANUAL_SUPPORT_EMAIL=support@hiremind.ai

# Payment (Razorpay — optional for demo)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
