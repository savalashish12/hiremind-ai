# Server
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true&connection_limit=1

# Auth
JWT_SECRET=your_jwt_secret_min_32_chars

# Google Gemini
GEMINI_API_KEY=your_gemini_api_key

# Groq (fallback AI)
GROQ_API_KEY=your_groq_api_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email (SMTP — works with Gmail, SendGrid, Mailgun, SES, ...)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_gmail@gmail.com
EMAIL_PASS=your_gmail_app_password
EMAIL_FROM=HireMind AI <your_gmail@gmail.com>

# Google OAuth 2.0 (Sign in with Google)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
# Optional override; default is <BACKEND_URL>/api/auth/google/callback
# GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Manual UPI checkout (owner payee shown in payment modal).
# Copy this block into backend/.env and replace every placeholder with YOUR
# real values. Code reads ONLY these vars — there are no hardcoded IDs.
# (Find your UPI ID in GPay/PhonePe → Profile; keep /upi-qr.jpg and put YOUR
# QR image at frontend/public/upi-qr.jpg — that file is gitignored.)
MANUAL_PAYEE_NAME=Your Full Name (as on bank account)
MANUAL_MERCHANT_LABEL=HireMind AI
MANUAL_UPI_PRIMARY=your-upi-id-1 (e.g. 9876543210@okhdfc)
MANUAL_UPI_SECONDARY=your-upi-id-2 (or repeat the primary one)
MANUAL_QR_IMAGE_URL=/upi-qr.jpg
MANUAL_SUPPORT_EMAIL=you@example.com

# Payment (Razorpay — NOT NEEDED. Ignore this whole block unless you ever
# enable Razorpay. The app's real checkout is the manual-UPI flow above.)
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
